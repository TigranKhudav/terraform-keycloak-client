# -------------------------
# Core
# -------------------------
variable "client_id" {
  description = "The client ID (clientId) for this Keycloak OpenID client."
  type        = string
}
variable "realm_id" {
  description = "The realm this client is attached to."
  type        = string
}
variable "name" {
  description = "Display name of the client shown in the Keycloak admin console."
  type        = string
  default     = null
}
variable "description" {
  description = "Description of the client shown in the Keycloak admin console."
  type        = string
  default     = null
}
variable "client_enabled" {
  description = "When false, the client cannot start a login or obtain tokens."
  type        = bool
  default     = true
}
variable "access_type" {
  description = "Client access type: CONFIDENTIAL, PUBLIC, or BEARER-ONLY."
  type        = string
  default     = "CONFIDENTIAL"
}
variable "client_authenticator_type" {
  description = "How the client authenticates: client-secret, client-jwt, client-secret-jwt, or client-x509. Set to client-jwt/client-secret-jwt for signed-JWT auth (provider >= 5.4)."
  type        = string
  default     = "client-secret"
}
variable "client_secret" {
  description = "Client secret for CONFIDENTIAL/BEARER-ONLY clients. Auto-generated by Keycloak if left null."
  type        = string
  default     = null
}
variable "import" {
  description = "Adopt an already-existing client instead of creating one (and skip deletion on destroy)."
  type        = bool
  default     = false
}

# -------------------------
# Flows / grant types
# -------------------------
variable "standard_flow_enabled" {
  description = "Enable the OAuth2 Authorization Code flow."
  type        = bool
  default     = false
}
variable "implicit_flow_enabled" {
  description = "Enable the OAuth2 Implicit flow."
  type        = bool
  default     = false
}
variable "direct_access_grants_enabled" {
  description = "Enable the OAuth2 Resource Owner Password Credentials (direct access) grant."
  type        = bool
  default     = true
}
variable "service_accounts_enabled" {
  description = "Enable the Client Credentials grant (service account) for this client."
  type        = bool
  default     = true
}
variable "oauth2_device_authorization_grant_enabled" {
  description = "Enable the OAuth2 Device Authorization grant."
  type        = bool
  default     = false
}
variable "oauth2_device_code_lifespan" {
  description = "Lifetime in seconds of the device code (device flow)."
  type        = string
  default     = null
}
variable "oauth2_device_polling_interval" {
  description = "Minimum polling interval in seconds for the device flow."
  type        = string
  default     = null
}
variable "standard_token_exchange_enabled" {
  description = "Enable Standard Token Exchange for this client (provider >= 5.x)."
  type        = bool
  default     = false
}
variable "allow_refresh_token_in_standard_token_exchange" {
  description = "Whether a refresh token may be issued during Standard Token Exchange: NO or SAME_SESSION."
  type        = string
  default     = null
}

# -------------------------
# Tokens / sessions / security
# -------------------------
variable "use_refresh_tokens" {
  description = "Issue a refresh token in the token response."
  type        = bool
  default     = false
}
variable "use_refresh_tokens_client_credentials" {
  description = "Issue refresh tokens for the client credentials grant."
  type        = bool
  default     = false
}
variable "pkce_code_challenge_method" {
  description = "PKCE code challenge method: plain, S256, or empty to disable."
  type        = string
  default     = null
}
variable "require_dpop_bound_tokens" {
  description = "Require DPoP-bound access tokens for this client (provider >= 5.6)."
  type        = bool
  default     = false
}
variable "full_scope_allowed" {
  description = "Include all of the user's role mappings in the access token (disable for scoped tokens)."
  type        = bool
  default     = true
}
variable "access_token_lifespan" {
  description = "Access token lifetime in seconds (overrides realm default)."
  type        = string
  default     = null
}
variable "client_offline_session_idle_timeout" {
  description = "Idle timeout in seconds for offline sessions of this client."
  type        = string
  default     = null
}
variable "client_offline_session_max_lifespan" {
  description = "Maximum lifetime in seconds for offline sessions of this client."
  type        = string
  default     = null
}
variable "client_session_idle_timeout" {
  description = "Idle timeout in seconds for sessions of this client."
  type        = string
  default     = null
}
variable "client_session_max_lifespan" {
  description = "Maximum lifetime in seconds for sessions of this client."
  type        = string
  default     = null
}

# -------------------------
# URLs / CORS
# -------------------------
variable "root_url" {
  description = "Root URL prepended to relative redirect URIs and web origins."
  type        = string
  default     = null
}
variable "base_url" {
  description = "Default URL Keycloak redirects to after login when none is specified."
  type        = string
  default     = null
}
variable "admin_url" {
  description = "URL to the client's admin interface (used for back-channel admin calls)."
  type        = string
  default     = null
}
variable "valid_redirect_uris" {
  description = "Allowed redirect URIs after successful login."
  type        = list(string)
  default     = null
}
variable "valid_post_logout_redirect_uris" {
  description = "Allowed redirect URIs after logout. Use [\"+\"] to reuse valid_redirect_uris."
  type        = list(string)
  default     = null
}
variable "web_origins" {
  description = "Allowed CORS origins. Use [\"+\"] for all valid redirect origins or [\"*\"] for all."
  type        = list(string)
  default     = null
}

# -------------------------
# Consent
# -------------------------
variable "consent_required" {
  description = "Require the user to grant consent before the client can access their data."
  type        = bool
  default     = false
}
variable "display_on_consent_screen" {
  description = "Show this client's info on the consent screen."
  type        = bool
  default     = false
}
variable "consent_screen_text" {
  description = "Text shown on the consent screen for this client."
  type        = string
  default     = null
}

# -------------------------
# Logout
# -------------------------
variable "frontchannel_logout_enabled" {
  description = "Enable front-channel logout for this client."
  type        = bool
  default     = true
}
variable "frontchannel_logout_url" {
  description = "URL Keycloak calls for front-channel logout."
  type        = string
  default     = null
}
variable "backchannel_logout_url" {
  description = "URL Keycloak calls for back-channel logout."
  type        = string
  default     = null
}
variable "backchannel_logout_session_required" {
  description = "Include the session ID in the back-channel logout token."
  type        = bool
  default     = true
}
variable "backchannel_logout_revoke_offline_sessions" {
  description = "Revoke offline sessions when a back-channel logout is received."
  type        = bool
  default     = false
}

# -------------------------
# Misc client behaviour
# -------------------------
variable "always_display_in_console" {
  description = "Always show this client in the account console, even without an active session."
  type        = bool
  default     = false
}
variable "login_theme" {
  description = "Login theme override for this client."
  type        = string
  default     = null
}
variable "exclude_issuer_from_auth_response" {
  description = "Omit the iss parameter from the authorization response."
  type        = string
  default     = null
}
variable "exclude_session_state_from_auth_response" {
  description = "Omit session_state from the authorization response."
  type        = string
  default     = null
}
variable "extra_config" {
  description = "Arbitrary additional client attributes passed straight through to Keycloak (key/value)."
  type        = map(string)
  default     = {}
}

# -------------------------
# Roles & service-account role assignments
# -------------------------
variable "roles" {
  description = "Client roles to create on this client."
  type        = list(string)
  default     = []
}
variable "service_accounts_roles" {
  description = "Realm role names to assign to this client's service account."
  type        = list(string)
  default     = []
}
variable "service_accounts_client_roles" {
  description = "Names of this client's own client roles (from var.roles) to assign to its own service account."
  type        = list(string)
  default     = []
}
variable "service_accounts_role_ids" {
  description = "IDs of roles owned by other clients to assign to this client's service account, e.g. module.other.role_id[\"reader\"] or data.keycloak_role.x.id."
  type        = list(string)
  default     = []
}

# -------------------------
# Client scopes
# -------------------------
variable "default_client_scopes" {
  description = "Default client scopes to assign (replaces Keycloak defaults). Null leaves them unmanaged."
  type        = list(string)
  default     = null
}
variable "optional_client_scopes" {
  description = "Optional client scopes to assign. Null leaves them unmanaged."
  type        = list(string)
  default     = null
}

# -------------------------
# Authentication flow / authorization
# -------------------------
variable "authentication_flow_binding_overrides" {
  description = "Override the realm's authentication flow bindings for this client."
  type = object({
    browser_id      = optional(string)
    direct_grant_id = optional(string)
  })
  default = null
}
variable "authorization" {
  description = "Enable fine-grained authorization services (resource server) for this client."
  type = object({
    policy_enforcement_mode          = optional(string)
    decision_strategy                = optional(string)
    allow_remote_resource_management = optional(bool, true)
    keep_defaults                    = optional(bool, false)
  })
  default = null
}

# -------------------------
# Protocol mappers
# -------------------------

# Audience mappers
variable "audience_mappers" {
  description = "Audience protocol mappers keyed by mapper name."
  type = map(object({
    included_custom_audience = optional(string)
    included_client_audience = optional(string)
    add_to_access_token      = optional(bool, true)
    add_to_id_token          = optional(bool, true)
  }))
  default = {}
}

# User session note mappers
variable "user_session_note_mappers" {
  description = "User session note protocol mappers keyed by mapper name."
  type = map(object({
    claim_name                 = string
    session_note               = optional(string)
    claim_value_type           = optional(string, "String")
    add_to_access_token        = optional(bool, false)
    add_to_id_token            = optional(bool, false)
    add_to_token_introspection = optional(bool, true)
  }))
  default = {}
}

# User attribute mappers
variable "user_attribute_mappers" {
  description = "User attribute protocol mappers keyed by mapper name."
  type = map(object({
    claim_name                 = string
    user_attribute             = string
    claim_value_type           = optional(string, "String")
    add_to_access_token        = optional(bool, false)
    add_to_id_token            = optional(bool, false)
    add_to_token_introspection = optional(bool, true)
    aggregate_attributes       = optional(bool, false)
    add_to_userinfo            = optional(bool, false)
    multivalued                = optional(bool, false)
  }))
  default = {}
}

# Group membership mappers
variable "group_attribute_mappers" {
  description = "Group membership protocol mappers keyed by mapper name."
  type = map(object({
    claim_name          = string
    full_path           = optional(bool, true)
    add_to_access_token = optional(bool, true)
    add_to_id_token     = optional(bool, true)
    add_to_userinfo     = optional(bool, true)
  }))
  default = {}
}

# User realm role mappers
variable "user_realm_role_mappers" {
  description = "User realm role protocol mappers keyed by mapper name."
  type = map(object({
    claim_name                 = string
    claim_value_type           = optional(string, "String")
    add_to_access_token        = optional(bool, true)
    add_to_id_token            = optional(bool, true)
    add_to_userinfo            = optional(bool, true)
    add_to_token_introspection = optional(bool, true)
    multivalued                = optional(bool, false)
    realm_role_prefix          = optional(string, "")
  }))
  default = {}
}

# User client role mappers
variable "user_client_role_mappers" {
  description = "User client role protocol mappers keyed by mapper name. Maps roles of client_id_for_role_mappings into the token."
  type = map(object({
    claim_name                  = string
    client_id_for_role_mappings = string
    client_role_prefix          = optional(string, "")
    claim_value_type            = optional(string, "String")
    multivalued                 = optional(bool, true)
    add_to_access_token         = optional(bool, true)
    add_to_id_token             = optional(bool, true)
    add_to_userinfo             = optional(bool, true)
  }))
  default = {}
}

# Hardcoded claim mappers
variable "hardcoded_claim_mappers" {
  description = "Hardcoded claim protocol mappers keyed by mapper name."
  type = map(object({
    claim_name          = string
    claim_value         = string
    claim_value_type    = optional(string, "String")
    add_to_access_token = optional(bool, true)
    add_to_id_token     = optional(bool, true)
    add_to_userinfo     = optional(bool, true)
  }))
  default = {}
}
